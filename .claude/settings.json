{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync --extra dev --frozen)",
      "Bash(uv lock --check)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(docker build -t webhooks-mcp:dev .)",
      "Bash(scripts/smoke.sh webhooks-mcp:dev)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.envrc)"
    ]
  }
}
